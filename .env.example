# Required in production — change this to a long random string
JWT_SECRET=tbc-deutschland-secret-2026

# Optional: path to folder where tbc-data.json is stored
# On Railway: set DATA_PATH=/data and mount a volume at /data
# DATA_PATH=/data

# Admin account (auto-created on startup if it doesn't exist)
# Change these in Railway Variables to set your real admin credentials
# ADMIN_EMAIL=admin@tbc-deutschland.de
# ADMIN_PASSWORD=admin123
# ADMIN_NAME=Admin

# HubSpot API Token
# HUBSPOT_TOKEN=pat-eu1-...

# Port (Railway sets this automatically)
# PORT=3000

# === Login / Password-Reset ===
# Only this email domain may log in or self-register via password reset
# ALLOWED_DOMAIN=thebrandingclub.com

# Public URL of the deployed app (used to build the password-reset link)
# Required in production. Example: https://tbc.up.railway.app
# APP_URL=

# Resend API key for sending password-reset / first-login emails
# Get one at https://resend.com → API Keys
# RESEND_API_KEY=re_...
# Sender address. Defaults to Resend's shared sandbox sender (onboarding@resend.dev),
# which can ONLY deliver to the email address that owns the Resend account.
# Override with a verified domain sender once you have DNS access.
# RESEND_FROM=onboarding@resend.dev
